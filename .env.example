POSTGRES_PASSWORD=replace-with-long-random-password
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-long-random-secret
TURN_SECRET=replace-with-long-random-turn-secret
TURN_URL=turn:localhost:3478?transport=udp
TURN_EXTERNAL_IP=127.0.0.1
API_BIND_HOST=127.0.0.1
ALLOWED_ORIGINS=localhost
MAX_FILE_BYTES=262144000
USER_QUOTA_BYTES=10737418240
# Необязательно: APNs для уведомлений iOS и фоновых звонков.
# APNS_KEY_FILE=./secrets/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=com.familychat.FamilyChatSelfhosted
APNS_SANDBOX=true
